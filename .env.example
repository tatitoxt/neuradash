# Application connection: must use the RLS-restricted role "neuradash_app".
DATABASE_URL=postgres://neuradash_app:app-password-change-me@localhost:5432/neuradash
# Owner connection: used only by db:setup (migrations) and db:seed.
DATABASE_OWNER_URL=postgres://postgres:postgres@localhost:5432/neuradash
# Session cookie "Secure" flag. Defaults to true when NODE_ENV=production; set false for plain-HTTP local runs.
COOKIE_SECURE=false
PORT=3000
